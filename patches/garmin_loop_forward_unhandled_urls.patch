diff --git a/Loop/Loop/Managers/LoopAppManager.swift b/Loop/Loop/Managers/LoopAppManager.swift
--- a/Loop/Loop/Managers/LoopAppManager.swift
+++ b/Loop/Loop/Managers/LoopAppManager.swift
@@ -706,4 +706,10 @@
     func handle(_ url: URL) -> Bool {
         guard let deeplink = Deeplink(url: url) else {
+            // Forward URLs Loop doesn't handle itself to interested services.
+            // Services are expected to validate URLs they actually requested.
+            log.default("Forwarding unhandled URL with host %{public}@", url.host ?? "(none)")
+            NotificationCenter.default.post(
+                name: Notification.Name("org.loopkit.Loop.didReceiveURL"), object: self, userInfo: ["url": url]
+            )
             return false
         }
